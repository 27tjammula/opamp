# --- Cadence locks: committing one makes a cell look locked to everyone ---
# Real names look like sch.oa.cdslck.RHEL30.<host>.<pid>
*.cdslck*
*.lck

# --- Cadence / editor backups ---
*.oa-
*.dm-
*.sdb-
*.cdb-
*%
*~
*.bak
*.tmp
*.swp
*.swl

# --- ADE results and run history (large, regenerated by re-running) ---
# The setup itself is kept: maestro.sdb, active.state, data.sdb, *_active
**/adexl/results/
**/adexl/test_states/**/*_none_*/
**/adexl/test_states/**/*tmpstate*/
**/maestro/results/
**/maestro/test_states/Interactive.*
**/maestro/test_states/ExplorerRun.*
**/maestro/test_states/MonteCarlo.*

# --- Simulator output, if a run directory ends up in the library ---
psf/
ahdlSimDB/
*.raw/
*.log
*.trn*
*.ahdlSimDB/

# --- Session files ---
.cadence/
.cache/
.config/
.abstract.*
.DS_Store
Thumbs.db
__pycache__/
.vscode/
.idea/
